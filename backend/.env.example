# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/hcp_crm

# Model for the LangGraph agent + extraction calls.
# gemma2-9b-it was decommissioned by Groq (2026-07); use llama-3.3-70b-versatile.
AGENT_MODEL=llama-3.3-70b-versatile
